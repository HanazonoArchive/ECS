# Auto detect text files and normalize line endings to LF
* text=auto

# Java source files
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.fxml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary

# Gradle
gradlew text eol=lf
gradlew.bat text eol=crlf
